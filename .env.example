# Copia este archivo como .env para configurar tu entorno local.
# npm run dev utiliza NODE_ENV=development automáticamente.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/organigrama.sqlite

# En nube con HTTPS, establece ambas variables en true.
AUTH_REQUIRED=false
AUTH_SECURE_COOKIES=false
